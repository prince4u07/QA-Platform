# ---------------------------------------------------------------------------
# Secrets — never commit. backend/.env holds the Gemini API key, DB
# password and JWT secret; .env.example is the checked-in template.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log

# ---------------------------------------------------------------------------
# Node / Vite frontend
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local

# Stray lint dumps from earlier sessions
lint-*.txt
full-lint.txt

# ---------------------------------------------------------------------------
# Runtime output from test runs. `sessions/` stores captured browser auth
# (cookies + localStorage) from real logins, so it is sensitive as well as
# large. The directories are recreated by the app on demand.
# ---------------------------------------------------------------------------
backend/static/uploads/

# ---------------------------------------------------------------------------
# Editor / OS / tooling
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
.claude/settings.local.json

# Word and Excel write a ~$ lock file next to any document that is open.
# It is a few bytes of session state and must never reach the repo.
~$*
docs/blackbook_draft_.docx
