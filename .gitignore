# ============================================================
# Secrets — NEVER commit these
# ============================================================
# Anyone with this file has the DB password, JWT signing key, and
# Anthropic API key. Use .env.example to share the *shape* of config.
.env
.env.local
.env.*.local
backend/.env
frontend/.env
*.pem
*.key

# Captured browser sessions = live auth cookies for real user accounts.
# Pushing these is equivalent to pushing a logged-in session token.
backend/static/uploads/sessions/

# ============================================================
# Generated runtime artifacts (recreate themselves, don't track)
# ============================================================
# Per-run screenshots, evidence crops, manual-run captures, uploaded
# project files. Can be 100s of MB and are reproducible from a test run.
backend/static/uploads/runs/
backend/static/uploads/evidence/
backend/static/uploads/manual_runs/
backend/static/uploads/projects/

# App logs (rotating). Recreated on every boot.
backend/logs/
*.log

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtualenvs (any name, any location)
venv/
.venv/
env/
ENV/
backend/venv/

# Test/build caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/

# ============================================================
# Node / Vite
# ============================================================
node_modules/
frontend/node_modules/

# Vite build output (regenerated by `npm run build`)
dist/
frontend/dist/

# Vite cache + temp
.vite/
frontend/.vite/

# npm/yarn/pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================================
# IDE / editor / OS
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================================
# Claude Code local state (per-machine, not project state)
# ============================================================
.claude/
CLAUDE.local.md

# ============================================================
# Misc
# ============================================================
*.bak
*.tmp
*.orig
