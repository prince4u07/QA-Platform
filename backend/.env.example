# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Database (MySQL) ---
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=qa_platform

# --- Auth ---
# Generate a strong random value, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# --- AI (Google Gemini) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Optional ---
# FLASK_DEBUG=0
# For a production WSGI server, start with 4 web workers and 4 threads,
# then validate with the plugin's 250-user load test and host metrics.
WEB_WORKERS=4
WEB_THREADS=4
RUNNER_WORKERS=4
WEB_CONNECTION_LIMIT=500
WEB_CHANNEL_TIMEOUT=120
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# The single admin account, matched on registration email.
ADMIN_EMAIL=you@example.com
